<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkLedger_Client.ViewModels"
        xmlns:models="using:WorkLedger_Client.Models"
        xmlns:converters="using:WorkLedger_Client.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WorkLedger_Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WorkLedger"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <converters:BooleanToTextDecorationsConverter x:Key="BooleanToTextDecorationsConverter"/>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationConverter"/>
        <converters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToChevronConverter x:Key="BooleanToChevronConverter"/>
        <converters:ActiveTaskToTagConverter x:Key="ActiveTaskToTagConverter" />
        <converters:ActiveProjectMatchConverter x:Key="ActiveProjectMatchConverter" />
    </Window.Resources>

    <Grid>
        <TabControl Background="Transparent" Padding="0">
        <TabControl.Styles>
            <!-- TabControl Wrapper Style -->
            <Style Selector="TabControl">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- Custom Tab Strip Style -->
            <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                <Setter Property="Margin" Value="20,0,20,0"/>
            </Style>

            <!-- Tab Item Style -->
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="700"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
                <Setter Property="Padding" Value="4,12,4,10"/>
                <Setter Property="Margin" Value="0,0,20,0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            
            <!-- Hide the default indicator if it's there, we'll draw our own or use Border -->
            <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
            </Style>

            <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
        </TabControl.Styles>
        <!-- Projects Tab -->
        <TabItem Header="Projects">
            <Grid Margin="{DynamicResource SpacingMediumThickness}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="44" Margin="-12,-12,-12,12" Background="{DynamicResource Surface}">
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Content="Create Project" Command="{Binding CreateProjectCommand}" 
                                    Background="{DynamicResource TealActive}" Foreground="White"
                                    FontSize="12" FontWeight="500" Padding="14,6" CornerRadius="7" 
                                    VerticalAlignment="Center" BorderThickness="0">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource TealGlow}" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                <CheckBox IsChecked="{Binding ShowArchivedTasks}" VerticalAlignment="Center" MinWidth="0">
                                    <CheckBox.Styles>
                                        <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                            <Setter Property="CornerRadius" Value="3" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </Style>
                                    </CheckBox.Styles>
                                    <TextBlock Text="Show Archived Tasks" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- 1/3 width -->
                        <ColumnDefinition Width="300" />
                        <!-- 2/3 width -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ProjectsList"
                             Grid.Column="0"
                             Margin="0"
                             Padding="0,6"
                             CornerRadius="0"
                             BorderThickness="0,0,1,0"
                             BorderBrush="{DynamicResource Border}"
                             Background="{DynamicResource Surface}"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="12" />
                                <Setter Property="Background" Value="#1a0d9488" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Project">
                                <Border Background="Transparent" Padding="16,11">
                                    <Grid x:Name="ProjectItemGrid" ColumnDefinitions="Auto,*,Auto">
                                        <Grid.Styles>
                                            <Style Selector="Grid">
                                            </Style>
                                        </Grid.Styles>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" 
                                            Background="{DynamicResource TealActive}" Opacity="0.14" />
                                    <TextBlock Grid.Column="0" Text="{Binding ProjectCode}" 
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="10" FontWeight="500" FontFamily="{DynamicResource FontMono}"
                                               Foreground="{DynamicResource TealActive}" />
                                    
                                    <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="500" FontFamily="{DynamicResource FontBody}"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Text="{Binding ProjectCode}" FontSize="10" FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextQuaternary}" />
                                            <Border Background="{DynamicResource TealActive}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="0,2,0,0"
                                                    BoxShadow="0 0 10 0 #400d9488"
                                                    VerticalAlignment="Center">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}">
                                                        <Binding Path="DataContext.ActiveProjectId" ElementName="ProjectsList" />
                                                        <Binding Path="Id" />
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="RUNNING" FontSize="9" FontWeight="800"
                                                           Foreground="White" LetterSpacing="0.5"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TealActive}">
                                            <Ellipse.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}">
                                                    <Binding Path="DataContext.ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Ellipse.IsVisible>
                                        </Ellipse>
                                        
                                        <Button Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}" ConverterParameter="Invert">
                                                    <Binding Path="DataContext.ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                            <Button.Command>
                                                <Binding Path="DataContext.EditProjectCommand" ElementName="ProjectsList" />
                                            </Button.Command>
                                            <Button.CommandParameter>
                                                <Binding />
                                            </Button.CommandParameter>
                                            <TextBlock Text="✏️" FontSize="13" Foreground="{DynamicResource AmberWarning}" Opacity="0.7" />
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}" ConverterParameter="Invert">
                                                    <Binding Path="DataContext.ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                            <Button.Command>
                                                <Binding Path="DataContext.DeleteProjectCommand" ElementName="ProjectsList" />
                                            </Button.Command>
                                            <Button.CommandParameter>
                                                <Binding />
                                            </Button.CommandParameter>
                                            <TextBlock Text="❌" FontSize="13" Foreground="{DynamicResource RedDanger}" Opacity="0.7" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="0"
                                  Width="4"
                                  HorizontalAlignment="Right"
                                  Background="{DynamicResource Border}"
                                  Margin="0,0,0,0" />

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0">
                        <!-- Project Header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,14,18,12" Background="{DynamicResource Surface}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProject.Name}" FontSize="16" FontWeight="700" FontFamily="{DynamicResource FontDisplay}" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TaskCount}" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="TASKS" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="·" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="THIS WEEK:" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="{Binding WeeklyTotal}" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TealActive}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding ActiveProjectId, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TealActive}" />
                                    <TextBlock Text="{Binding ActiveTimerValue}" FontSize="26" FontWeight="500" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TealActive}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="TasksList"
                                 Grid.Row="1"
                                 Padding="12,10"
                                 Background="{DynamicResource Background}"
                                 ItemsSource="{Binding Tasks}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:TaskItemViewModel">
                                    <Border CornerRadius="8" BorderThickness="1" Background="{DynamicResource Surface}">
                                        <Border.Styles>
                                            <Style Selector="Border">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                                <Setter Property="Opacity" Value="0.75" />
                                            </Style>
                                            <!-- Active Task treatment -->
                                            <Style Selector="Border[Tag=Active]">
                                                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
                                                <Setter Property="Background" Value="#1a0d9488" /> <!-- Subtle teal bg -->
                                                <Setter Property="Opacity" Value="1.0" />
                                            </Style>
                                        </Border.Styles>
                                        <Border.Tag>
                                            <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </Border.Tag>
                                        
                                        <StackPanel>
                                            <Border Padding="12,10">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Grid.Styles>
                                                        <Style Selector="Grid">
                                                        </Style>
                                                    </Grid.Styles>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="0">
                                                    <CheckBox.Styles>
                                                        <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
                                                        </Style>
                                                        <Style Selector="CheckBox[Tag=Active] /template/ Border#NormalRectangle">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
                                                        </Style>
                                                    </CheckBox.Styles>
                                                    <CheckBox.Tag>
                                                        <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                            <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                            <Binding Path="Id" />
                                                        </MultiBinding>
                                                    </CheckBox.Tag>
                                                </CheckBox>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           FontSize="13" FontWeight="500" FontFamily="{DynamicResource FontBody}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationsConverter}}" />
                                                
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="TOTAL" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                                    <TextBlock Text="{Binding TotalTime}" FontSize="12" FontWeight="500" FontFamily="{DynamicResource FontMono}">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                            </Style>
                                                            <Style Selector="TextBlock[Tag=Active]">
                                                                <Setter Property="Foreground" Value="{DynamicResource TealActive}" />
                                                            </Style>
                                                        </TextBlock.Styles>
                                                        <TextBlock.Tag>
                                                            <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                                <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                                <Binding Path="Id" />
                                                            </MultiBinding>
                                                        </TextBlock.Tag>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" Margin="8,0,0,0">
                                                    <!-- Actions -->
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleTimerCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="⏱️" FontSize="14" Foreground="{DynamicResource TealActive}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).EditTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="✏️" FontSize="14" Foreground="{DynamicResource AmberWarning}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="❌" FontSize="14" Foreground="{DynamicResource RedDanger}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ArchiveTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="📦" FontSize="14" Foreground="{DynamicResource TextTertiary}" />
                                                    </Button>
                                                    <ToggleButton IsChecked="{Binding IsExpanded}" Background="Transparent" Padding="0" BorderThickness="0">
                                                        <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BooleanToChevronConverter}}" FontSize="28" Foreground="{DynamicResource TextTertiary}" />
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Grid>
                                            </Border>
                                            
                                            <!-- Time Entries -->
                                            <ItemsControl ItemsSource="{Binding TimeEntries}" IsVisible="{Binding IsExpanded}" Margin="36,0,12,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:TimeEntry">
                                                        <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,3">
                                                        <Border Padding="8,5">
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <Grid.Styles>
                                                                    <Style Selector="Grid">
                                                                    </Style>
                                                                </Grid.Styles>
                                                                <TextBlock Grid.Column="0" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextSecondary}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0:yyyy-MM-dd}: {0:HH:mm:ss} – {1:HH:mm:ss}">
                                                                            <Binding Path="StartTime" Converter="{StaticResource UtcToLocalTimeConverter}"/>
                                                                            <Binding Path="EndTime" Converter="{StaticResource UtcToLocalTimeConverter}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding DurationSeconds, Converter={StaticResource SecondsToDurationConverter}}" 
                                                                           FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" />
                                                                <Button Grid.Column="2" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTimeEntryCommand}" CommandParameter="{Binding}" 
                                                                        Background="Transparent" Padding="0">
                                                                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource RedDanger}" Opacity="0.4">
                                                                        <TextBlock.Styles>
                                                                            <Style Selector="TextBlock:pointerover">
                                                                                <Setter Property="Opacity" Value="0.9" />
                                                                            </Style>
                                                                        </TextBlock.Styles>
                                                                    </TextBlock>
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Floating create task button at bottom-right (rounded, centered "+") -->
                        <Button Grid.Row="1" Width="40" Height="40"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16"
                                Command="{Binding CreateTaskCommand}"
                                Padding="0"
                                FontSize="22"
                                FontWeight="Light"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="20"
                                Background="{DynamicResource TealActive}"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTip.Tip="Create Task">
                            <Button.Styles>
                                <Style Selector="Button">
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="+" Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Reports">
            <Border Padding="{DynamicResource SpacingXXLargeThickness}">
                <StackPanel Spacing="{DynamicResource SpacingXLarge}">
                    <TextBlock Margin="0 5" xml:space="preserve" Foreground="{DynamicResource TextSecondary}">This feature will be implemented in a future release</TextBlock>
                </StackPanel>
            </Border>
        </TabItem>
    </TabControl>
        
        <Border Background="{DynamicResource Surface}" Height="22" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TealActive}" />
                    <TextBlock Text="WorkLedger · running" FontSize="9" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextQuaternary}" LetterSpacing="0.12" />
                </StackPanel>
                <TextBlock Text="offline-first" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="9" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextQuaternary}" LetterSpacing="0.12" />
            </Grid>
        </Border>
    </Grid>
</Window>
