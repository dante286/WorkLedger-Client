<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WorkLedger_Client.ViewModels"
        xmlns:models="using:WorkLedger_Client.Models"
        xmlns:converters="using:WorkLedger_Client.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WorkLedger_Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WorkLedger"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

    <Window.Resources>
        <converters:BooleanToTextDecorationsConverter x:Key="BooleanToTextDecorationsConverter"/>
        <converters:SecondsToDurationConverter x:Key="SecondsToDurationConverter"/>
        <converters:UtcToLocalTimeConverter x:Key="UtcToLocalTimeConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BooleanToChevronConverter x:Key="BooleanToChevronConverter"/>
        <converters:ActiveTaskToTagConverter x:Key="ActiveTaskToTagConverter" />
        <converters:ActiveProjectMatchConverter x:Key="ActiveProjectMatchConverter" />
        <converters:BooleanToArchiveColorConverter x:Key="BooleanToArchiveColorConverter" />
        <converters:BackupIntervalToDisplayConverter x:Key="BackupIntervalToDisplayConverter" />
        <converters:SyncModeToDisplayConverter x:Key="SyncModeToDisplayConverter" />
        <converters:SyncIntervalToDisplayConverter x:Key="SyncIntervalToDisplayConverter" />
        <converters:PreMergeBackupModeToDisplayConverter x:Key="PreMergeBackupModeToDisplayConverter" />
    </Window.Resources>

    <Grid>
        <TabControl Background="Transparent" Padding="0">
        <TabControl.Styles>
            <!-- TabControl Wrapper Style -->
            <Style Selector="TabControl">
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <!-- Custom Tab Strip Style -->
            <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                <Setter Property="Margin" Value="20,0,20,0"/>
            </Style>

            <!-- Tab Item Style -->
            <Style Selector="TabItem">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="700"/>
                <Setter Property="FontFamily" Value="{DynamicResource FontDisplay}"/>
                <Setter Property="Padding" Value="4,12,4,10"/>
                <Setter Property="Margin" Value="0,0,20,0"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="VerticalAlignment" Value="Bottom"/>
                <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}"/>
                <Setter Property="Background" Value="Transparent"/>
            </Style>

            <Style Selector="TabItem:selected">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
            
            <!-- Hide the default indicator if it's there, we'll draw our own or use Border -->
            <Style Selector="TabItem /template/ Border#PART_SelectedPipe">
                <Setter Property="IsVisible" Value="False" />
            </Style>

            <Style Selector="TabItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderThickness" Value="0,0,0,2" />
                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
            </Style>

            <Style Selector="TabItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextPrimary}"/>
            </Style>
        </TabControl.Styles>
        <!-- Projects Tab -->
        <TabItem Header="Projects">
            <Grid Margin="{DynamicResource SpacingMediumThickness}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Height="44" Margin="-12,-12,-12,12" Background="{DynamicResource Surface}">
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
                        <Grid Margin="20,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Content="Create Project" Command="{Binding CreateProjectCommand}"
                                    Background="{DynamicResource TealActive}" Foreground="White"
                                    FontSize="13" FontWeight="500" Padding="14,6" CornerRadius="7"
                                    VerticalAlignment="Center" BorderThickness="0">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource TealGlow}" />
                                    </Style>
                                </Button.Styles>
                            </Button>
                            
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                                <CheckBox IsChecked="{Binding ShowArchivedTasks}" VerticalAlignment="Center" MinWidth="0">
                                    <CheckBox.Styles>
                                        <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                            <Setter Property="CornerRadius" Value="3" />
                                            <Setter Property="BorderThickness" Value="1.5" />
                                        </Style>
                                    </CheckBox.Styles>
                                    <TextBlock Text="Show Archived Tasks" FontSize="13" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                </CheckBox>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- 1/3 width -->
                        <ColumnDefinition Width="300" />
                        <!-- 2/3 width -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ListBox x:Name="ProjectsList"
                             x:DataType="vm:MainWindowViewModel"
                             Grid.Column="0"
                             Margin="0"
                             Padding="0,6"
                             CornerRadius="0"
                             BorderThickness="0,0,1,0"
                             BorderBrush="{DynamicResource Border}"
                             Background="{DynamicResource Surface}"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Stretch">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Project">
                                <Border x:Name="ProjectItemBorder"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        Padding="14,11,16,11">
                                    <Border.Styles>
                                        <Style Selector="Border#ProjectItemBorder">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="BorderBrush" Value="Transparent" />
                                            <Setter Property="BorderThickness" Value="0" />
                                        </Style>
                                        <Style Selector="ListBoxItem:selected Border#ProjectItemBorder">
                                            <Setter Property="Background" Value="{DynamicResource SelectedProjectBackground}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource SelectedProjectBorder}" />
                                            <Setter Property="BorderThickness" Value="2,0,0,0" />
                                        </Style>
                                    </Border.Styles>
                                    <Grid x:Name="ProjectItemGrid" ColumnDefinitions="Auto,*,Auto">
                                        <Grid.Styles>
                                            <Style Selector="Grid">
                                            </Style>
                                        </Grid.Styles>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" 
                                            Background="{DynamicResource TealActive}" Opacity="0.14" />
                                    <TextBlock Grid.Column="0" Text="{Binding ProjectCode}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               FontSize="11" FontWeight="500" FontFamily="{DynamicResource FontMono}"
                                               Foreground="{DynamicResource TealActive}" />
                                    
                                    <StackPanel Grid.Column="1" Margin="11,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="500" FontFamily="{DynamicResource FontMono}"
                                                   Foreground="{DynamicResource TextPrimary}" />
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Border Background="{DynamicResource TealActive}"
                                                    CornerRadius="10"
                                                    Padding="8,2"
                                                    Margin="0,2,0,0"
                                                    BoxShadow="0 0 10 0 #400d9488"
                                                    VerticalAlignment="Center">
                                                <Border.IsVisible>
                                                    <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}">
                                                    <Binding Path="((vm:MainWindowViewModel)DataContext).ActiveProjectId" ElementName="ProjectsList" />
                                                        <Binding Path="Id" />
                                                    </MultiBinding>
                                                </Border.IsVisible>
                                                <TextBlock Text="RUNNING" FontSize="10" FontWeight="800"
                                                           Foreground="White" LetterSpacing="0.5"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource TealActive}">
                                            <Ellipse.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}">
                                                    <Binding Path="((vm:MainWindowViewModel)DataContext).ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Ellipse.IsVisible>
                                        </Ellipse>
                                        
                                        <Button Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}" ConverterParameter="Invert">
                                                    <Binding Path="((vm:MainWindowViewModel)DataContext).ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                            <Button.Command>
                                                <Binding Path="((vm:MainWindowViewModel)DataContext).EditProjectCommand" ElementName="ProjectsList" />
                                            </Button.Command>
                                            <Button.CommandParameter>
                                                <Binding />
                                            </Button.CommandParameter>
                                            <TextBlock Text="✏️" FontSize="13" Foreground="{DynamicResource AmberWarning}" Opacity="0.7" />
                                        </Button>
                                        <Button Background="Transparent" BorderThickness="0" Padding="0">
                                            <Button.IsVisible>
                                                <MultiBinding Converter="{StaticResource ActiveProjectMatchConverter}" ConverterParameter="Invert">
                                                    <Binding Path="((vm:MainWindowViewModel)DataContext).ActiveProjectId" ElementName="ProjectsList" />
                                                    <Binding Path="Id" />
                                                </MultiBinding>
                                            </Button.IsVisible>
                                            <Button.Command>
                                                <Binding Path="((vm:MainWindowViewModel)DataContext).DeleteProjectCommand" ElementName="ProjectsList" />
                                            </Button.Command>
                                            <Button.CommandParameter>
                                                <Binding />
                                            </Button.CommandParameter>
                                            <TextBlock Text="❌" FontSize="13" Foreground="{DynamicResource RedDanger}" Opacity="0.7" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <GridSplitter Grid.Column="0"
                                  Width="4"
                                  HorizontalAlignment="Right"
                                  Background="{DynamicResource Border}"
                                  Margin="0,0,0,0" />

                    <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="0">
                        <!-- Project Header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="18,14,18,12" Background="{DynamicResource Surface}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedProject.Name}" FontSize="16" FontWeight="700" FontFamily="{DynamicResource FontDisplay}" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding TaskCount}" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="Tasks" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextSecondary}" />
                                        <TextBlock Text="·" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="This Week:" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                        <TextBlock Text="{Binding WeeklyTotal}" FontSize="11" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TealActive}" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8" IsVisible="{Binding ActiveProjectId, Converter={x:Static ObjectConverters.IsNotNull}}">
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource TealActive}" />
                                    <TextBlock Text="{Binding ActiveTimerValue}" FontSize="26" FontWeight="500" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TealActive}" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ListBox x:Name="TasksList"
                                 x:DataType="vm:MainWindowViewModel"
                                 Grid.Row="1"
                                 Padding="12,10"
                                 Background="{DynamicResource Background}"
                                 ItemsSource="{Binding Tasks}"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Stretch"
                                 BorderThickness="0">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="0,0,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="vm:TaskItemViewModel">
                                    <Border x:Name="TaskCard" CornerRadius="8" BorderThickness="1" Background="{DynamicResource Surface}">
                                        <Border.Styles>
                                            <!-- Scoped to #TaskCard only - an unscoped "Border" selector here would
                                                 also match the nested TaskHeader/time-entry Borders below and dim
                                                 their text even when this card is active. -->
                                            <Style Selector="Border#TaskCard">
                                                <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                                <Setter Property="Opacity" Value="0.75" />
                                                <Setter Property="BoxShadow" Value="0 1 4 0 #0D000000" />
                                            </Style>
                                            <!-- Active Task treatment -->
                                            <Style Selector="Border#TaskCard[Tag=Active]">
                                                <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
                                                <Setter Property="Background" Value="#1a0d9488" /> <!-- Subtle teal bg -->
                                                <Setter Property="Opacity" Value="1.0" />
                                                <Setter Property="BoxShadow" Value="0 2 10 0 #140d9488" />
                                            </Style>
                                        </Border.Styles>
                                        <Border.Tag>
                                            <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                <Binding Path="Id" />
                                            </MultiBinding>
                                        </Border.Tag>
                                        
                                        <StackPanel>
                                            <Border x:Name="TaskHeader" Padding="12,10" Classes.expanded="{Binding IsExpanded}">
                                                <Border.Styles>
                                                    <Style Selector="Border#TaskHeader.expanded">
                                                        <Setter Property="Background" Value="{DynamicResource Surface2}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    </Style>
                                                </Border.Styles>
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Grid.Styles>
                                                        <Style Selector="Grid">
                                                        </Style>
                                                    </Grid.Styles>
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsCompleted}" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="0">
                                                    <CheckBox.Styles>
                                                        <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource Border2}" />
                                                        </Style>
                                                        <Style Selector="CheckBox[Tag=Active] /template/ Border#NormalRectangle">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource TealActive}" />
                                                        </Style>
                                                    </CheckBox.Styles>
                                                    <CheckBox.Tag>
                                                        <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                            <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                            <Binding Path="Id" />
                                                        </MultiBinding>
                                                    </CheckBox.Tag>
                                                </CheckBox>
                                                
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                           FontSize="14" FontWeight="500" FontFamily="{DynamicResource FontBody}"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextDecorations="{Binding IsCompleted, Converter={StaticResource BooleanToTextDecorationsConverter}}" />
                                                
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="Total" FontSize="12" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextTertiary}" />
                                                    <TextBlock Text="{Binding TotalTime}" FontSize="13" FontWeight="500" FontFamily="{DynamicResource FontMono}">
                                                        <TextBlock.Styles>
                                                            <Style Selector="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                            </Style>
                                                            <Style Selector="TextBlock[Tag=Active]">
                                                                <Setter Property="Foreground" Value="{DynamicResource TealActive}" />
                                                            </Style>
                                                        </TextBlock.Styles>
                                                        <TextBlock.Tag>
                                                            <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                                <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                                <Binding Path="Id" />
                                                            </MultiBinding>
                                                        </TextBlock.Tag>
                                                    </TextBlock>
                                                </StackPanel>
                                                
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12" Margin="12,0,0,0">
                                                    <!-- Actions -->
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleTimerCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="⏱️" FontSize="16">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextQuaternary}" />
                                                                </Style>
                                                                <Style Selector="TextBlock[Tag=Active]">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TealActive}" />
                                                                    <Setter Property="Opacity" Value="1.0" />
                                                                </Style>
                                                            </TextBlock.Styles>
                                                            <TextBlock.Tag>
                                                                <MultiBinding Converter="{StaticResource ActiveTaskToTagConverter}">
                                                                    <Binding Path="$parent[ListBox].((vm:MainWindowViewModel)DataContext).ActiveTaskId" />
                                                                    <Binding Path="Id" />
                                                                </MultiBinding>
                                                            </TextBlock.Tag>
                                                        </TextBlock>
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).EditTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="✏️" FontSize="16" Foreground="{DynamicResource TextQuaternary}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).DeleteTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="❌" FontSize="16" Foreground="{DynamicResource TextQuaternary}" />
                                                    </Button>
                                                    <Button Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ToggleArchiveTaskCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0">
                                                        <TextBlock Text="📦" FontSize="16" Foreground="{DynamicResource TextQuaternary}" />
                                                    </Button>
                                                    <ToggleButton IsChecked="{Binding IsExpanded}" Background="Transparent" Padding="0" BorderThickness="0">
                                                        <TextBlock Text="{Binding IsExpanded, Converter={StaticResource BooleanToChevronConverter}}" FontSize="28" Foreground="{DynamicResource TextTertiary}" />
                                                    </ToggleButton>
                                                </StackPanel>
                                            </Grid>
                                            </Border>
                                            
                                            <!-- Time Entries -->
                                            <ItemsControl ItemsSource="{Binding TimeEntries}" IsVisible="{Binding IsExpanded}" Margin="36,4,12,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="models:TimeEntry">
                                                        <!-- Use stronger surface and clearer text colors for better contrast -->
                                                        <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="5" Margin="0,0,0,3">
                                                        <Border Padding="8,6">
                                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                                <Grid.Styles>
                                                                    <Style Selector="Grid">
                                                                    </Style>
                                                                </Grid.Styles>
                                                                <TextBlock Grid.Column="0" FontSize="12" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimary}" FontWeight="500">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding StringFormat="{}{0:yyyy-MM-dd}: {0:HH:mm:ss} – {1:HH:mm:ss}">
                                                                            <Binding Path="StartTime" Converter="{StaticResource UtcToLocalTimeConverter}"/>
                                                                            <Binding Path="EndTime" Converter="{StaticResource UtcToLocalTimeConverter}"/>
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Grid.Column="1" Text="{Binding DurationSeconds, Converter={StaticResource SecondsToDurationConverter}}" 
                                                                           FontSize="12" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimary}" Margin="0,0,8,0" FontWeight="600" />
                                                                <Button Grid.Column="2" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteTimeEntryCommand}" CommandParameter="{Binding}" 
                                                                        Background="Transparent" Padding="0" BorderThickness="0">
                                                                    <Button.Styles>
                                                                        <Style Selector="Button">
                                                                            <Setter Property="Opacity" Value="0.85" />
                                                                        </Style>
                                                                        <Style Selector="Button:pointerover">
                                                                            <Setter Property="Opacity" Value="1" />
                                                                        </Style>
                                                                    </Button.Styles>
                                                                    <TextBlock Text="✕" FontSize="12" FontWeight="700" Foreground="{DynamicResource RedDanger}" />
                                                                </Button>
                                                            </Grid>
                                                        </Border>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Floating create task button at bottom-right (rounded, centered "+") -->
                        <Button Grid.Row="1" Width="40" Height="40"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,16,16"
                                Command="{Binding CreateTaskCommand}"
                                Padding="0"
                                FontSize="22"
                                FontWeight="Light"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                CornerRadius="20"
                                Background="{DynamicResource TealActive}"
                                Foreground="White"
                                BorderThickness="0"
                                ToolTip.Tip="Create Task">
                            <Button.Styles>
                                <Style Selector="Button">
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="+" Margin="0,-2,0,0"/>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="Reports">
            <Border Padding="{DynamicResource SpacingXXLargeThickness}">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- Week header: which week this is, what it adds up to, and the actions. -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{Binding WeeklyReport.WeekRangeLabel}"
                                       FontFamily="{DynamicResource FontDisplay}" FontSize="16" FontWeight="700"
                                       Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock Foreground="{DynamicResource TextTertiary}" FontSize="12"
                                       Text="Weeks run Monday to Sunday in UTC, matching the server's weekly rollup" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" FontSize="12">Total</TextBlock>
                            <TextBlock VerticalAlignment="Center" Text="{Binding WeeklyReport.TotalDuration}"
                                       FontFamily="{DynamicResource FontMono}" FontSize="15" FontWeight="700"
                                       Foreground="{DynamicResource TealActive}" />

                            <Button Command="{Binding RefreshReportCommand}" IsEnabled="{Binding !IsBuildingReport}"
                                    Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                    FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                    VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                <TextBlock Text="Refresh" />
                            </Button>

                            <Button Command="{Binding ExportReportCsvCommand}"
                                    Background="{DynamicResource TealActive}" Foreground="White"
                                    FontSize="13" FontWeight="500" Padding="14,6" CornerRadius="7"
                                    VerticalAlignment="Center" BorderThickness="0">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource TealGlow}" />
                                    </Style>
                                </Button.Styles>
                                <TextBlock Text="Export CSV" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBlock Grid.Row="1" Margin="0,24,0,0" IsVisible="{Binding WeeklyReport.IsEmpty}"
                               Foreground="{DynamicResource TextSecondary}" FontSize="13"
                               Text="No completed time entries this week yet. Start a timer on a task and it will show up here." />

                    <ScrollViewer Grid.Row="2" Margin="0,20,0,0">
                        <ItemsControl ItemsSource="{Binding WeeklyReport.Projects}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ProjectReportRow">
                                    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding ProjectName}"
                                                           FontWeight="600" FontSize="14"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                                           FontFamily="{DynamicResource FontMono}" FontSize="13" FontWeight="600"
                                                           Foreground="{DynamicResource TextPrimary}" />
                                            </Grid>

                                            <!-- One level further down: the same week, per task. -->
                                            <ItemsControl ItemsSource="{Binding Tasks}" Margin="12,0,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:TaskReportRow">
                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                            <TextBlock Grid.Column="0" Text="{Binding TaskName}"
                                                                       FontSize="13"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Duration}"
                                                                       FontFamily="{DynamicResource FontMono}" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondary}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </TabItem>

        <TabItem Header="Settings">
            <Border Padding="{DynamicResource SpacingXXLargeThickness}">
                <!-- Scrollable since the Sync section: the tab is now taller than a small window. -->
                <ScrollViewer>
                    <StackPanel Spacing="{DynamicResource SpacingXLarge}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Theme</TextBlock>
                        <ComboBox Width="160" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Data Directory</TextBlock>
                        <TextBox Width="320" Text="{Binding DataDirectory, Mode=TwoWay}" />
                        <Button Margin="8,0,0,0" Command="{Binding BrowseDataDirectoryCommand}"
                                Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <TextBlock Text="Browse" />
                        </Button>
                        <Button Command="{Binding SaveSettingsCommand}" Margin="12,0,0,0"
                                Background="{DynamicResource TealActive}" Foreground="White"
                                FontSize="13" FontWeight="500" Padding="14,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource TealGlow}" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Save" />
                        </Button>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Application version</TextBlock>
                        <TextBlock Width="160" VerticalAlignment="Center" Text="{Binding ApplicationVersion}" />
                    </StackPanel>

                    <!-- Backup Settings -->
                    <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="600" FontSize="14" Margin="0,8,0,0">Backup</TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Backup Folder</TextBlock>
                        <TextBox Width="280" Text="{Binding BackupDirectory, Mode=TwoWay}" />
                        <Button Margin="8,0,0,0" Command="{Binding PickBackupFolderCommand}"
                                Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <TextBlock Text="Pick Folder" />
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Backup Interval</TextBlock>
                        <ComboBox Width="160" ItemsSource="{Binding BackupIntervalOptions}" SelectedItem="{Binding BackupInterval, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource BackupIntervalToDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <CheckBox IsChecked="{Binding BackupOnClose, Mode=TwoWay}" VerticalAlignment="Center" MinWidth="0">
                            <CheckBox.Styles>
                                <Style Selector="CheckBox /template/ Border#NormalRectangle">
                                    <Setter Property="CornerRadius" Value="3" />
                                    <Setter Property="BorderThickness" Value="1.5" />
                                </Style>
                            </CheckBox.Styles>
                            <TextBlock Text="Back up on close" Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" />
                        </CheckBox>
                    </StackPanel>

                    <!-- Sync Settings -->
                    <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="600" FontSize="14" Margin="0,12,0,0">Sync</TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Sync Mode</TextBlock>
                        <ComboBox Width="160" ItemsSource="{Binding SyncModeOptions}" SelectedItem="{Binding SyncMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SyncModeToDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Command="{Binding SyncNowCommand}" IsEnabled="{Binding !IsSyncing}" Margin="12,0,0,0"
                                Background="{DynamicResource TealActive}" Foreground="White"
                                FontSize="13" FontWeight="500" Padding="14,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource TealGlow}" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Sync Now" />
                        </Button>
                    </StackPanel>

                    <!-- Folder sync: only relevant when the mode actually uses a folder. -->
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center"
                                IsVisible="{Binding IsFileSyncSelected}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Sync Folder</TextBlock>
                        <TextBox Width="280" Text="{Binding SyncFolderPath, Mode=TwoWay}" />
                        <Button Margin="8,0,0,0" Command="{Binding PickSyncFolderCommand}"
                                Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                            <TextBlock Text="Pick Folder" />
                        </Button>
                    </StackPanel>

                    <!-- API sync: endpoint, then signing in against it. WL-145.

                         Deliberately only a sign-in: registration, "Claim this server" and the
                         /auth/capabilities probe that decides whether to show either are plan 9.
                         Enrolling this device is a side effect of signing in, server-side, so
                         there is nothing else for a new install to do here. -->
                    <StackPanel Spacing="{DynamicResource SpacingLarge}" IsVisible="{Binding IsApiSyncSelected}">
                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">API Endpoint</TextBlock>
                            <TextBox Width="320" Text="{Binding ApiEndpoint, Mode=TwoWay}" Watermark="https://workledger.example.com" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Email</TextBlock>
                            <TextBox Width="240" Text="{Binding ApiEmail, Mode=TwoWay}" Watermark="you@example.com" />
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="8,0,8,0">Password</TextBlock>
                            <TextBox Width="180" PasswordChar="•" Text="{Binding ApiPassword, Mode=TwoWay}" />
                            <Button Margin="8,0,0,0" Command="{Binding SignInCommand}"
                                    Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                    FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                    VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                <TextBlock Text="Sign in" />
                            </Button>
                            <Button Margin="4,0,0,0" Command="{Binding SignOutCommand}"
                                    IsVisible="{Binding !IsSignedOutOfApi}"
                                    Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}"
                                    FontSize="13" FontWeight="500" Padding="8,6" CornerRadius="7"
                                    VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource Border}">
                                <TextBlock Text="Sign out" />
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Device</TextBlock>
                            <TextBlock VerticalAlignment="Center" Text="{Binding DeviceId}" FontFamily="{DynamicResource FontMono}" FontSize="12" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Status</TextBlock>
                            <TextBlock VerticalAlignment="Center" Text="{Binding ApiTokenStatus}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center"
                                IsVisible="{Binding IsSyncConfigured}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Sync Interval</TextBlock>
                        <ComboBox Width="160" ItemsSource="{Binding SyncIntervalOptions}" SelectedItem="{Binding SyncInterval, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource SyncIntervalToDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center"
                                IsVisible="{Binding IsSyncConfigured}">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Backup Before Merge</TextBlock>
                        <ComboBox Width="160" ItemsSource="{Binding PreMergeBackupModeOptions}" SelectedItem="{Binding PreMergeBackupMode, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PreMergeBackupModeToDisplayConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" FontSize="12">Copies the database into pre-merge-backups before a remote change overwrites local data</TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="0,0,8,0">Last Synced</TextBlock>
                        <TextBlock VerticalAlignment="Center" Text="{Binding LastSyncedDisplay}" />
                    </StackPanel>

                    <!-- Restore Settings -->
                    <TextBlock Foreground="{DynamicResource TextPrimary}" FontWeight="600" FontSize="14" Margin="0,12,0,0">Restore</TextBlock>

                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpacingLarge}" VerticalAlignment="Center">
                        <Button Command="{Binding RestoreFromFolderCommand}"
                                Background="{DynamicResource AmberWarning}" Foreground="{DynamicResource Ink950}"
                                FontSize="13" FontWeight="500" Padding="14,6" CornerRadius="7"
                                VerticalAlignment="Center" BorderThickness="0">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="{DynamicResource AmberLight}" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Restore from Folder" />
                        </Button>
                        <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource TextTertiary}" FontSize="12">Select folder with settings.json and workledger.db</TextBlock>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </TabItem>
    </TabControl>

        
        <Border Background="{DynamicResource Surface}" Height="22" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" VerticalAlignment="Bottom">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                    <Ellipse Width="5" Height="5" Fill="{DynamicResource TealActive}" />
                    <TextBlock Text="WorkLedger · running" FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextQuaternary}" LetterSpacing="0.12" />
                </StackPanel>
                <TextBlock Text="offline-first" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="10" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextQuaternary}" LetterSpacing="0.12" />
            </Grid>
        </Border>
    </Grid>
</Window>
