<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WorkLedger_Client.Views"
        x:Class="WorkLedger_Client.Views.ConfirmationDialog"
        x:DataType="views:ConfirmationDialog"
        Width="350" Height="120"
        Title="Confirm Delete"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{DynamicResource FontBody}">

  <Border Padding="20" Background="{DynamicResource Surface}">
    <StackPanel Spacing="20">
      <TextBlock FontFamily="{DynamicResource FontBody}" FontSize="14" IsVisible="{Binding HasPrompt}">
        <Run Text="Are you sure you want to" />
        <Run Text="{Binding Action}" />
        <Run Text="this" />
        <Run Text="{Binding ItemType}" />
        <Run Text="?" />
      </TextBlock>

      <!-- WL-141/WL-143: the confirmations in the account panel are paragraphs, not a sentence.
           What is NOT being deleted is the part that has to be read, so it wraps rather than being
           truncated into a reassuring half-statement. -->
      <TextBlock FontFamily="{DynamicResource FontBody}" FontSize="13" IsVisible="{Binding HasMessage}"
                 Text="{Binding Message}" TextWrapping="Wrap" LineHeight="19" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="{Binding CancelLabel}" 
                Click="OnNo" 
                MinWidth="80" 
                Background="{DynamicResource Surface}"
                Foreground="{DynamicResource TextPrimary}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1"
                CornerRadius="4">
          <Button.Styles>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="{DynamicResource Surface2}" />
            </Style>
          </Button.Styles>
        </Button>
        <Button Content="{Binding ConfirmLabel}" 
                Click="OnYes" 
                IsDefault="True" 
                MinWidth="80"
                Background="{DynamicResource TealActive}" 
                Foreground="White"
                BorderThickness="0"
                CornerRadius="4">
          <Button.Styles>
            <Style Selector="Button:pointerover">
              <Setter Property="Background" Value="{DynamicResource TealGlow}" />
            </Style>
          </Button.Styles>
        </Button>
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
