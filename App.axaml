<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WorkLedger_Client.App"
             xmlns:local="using:WorkLedger_Client"
             RequestedThemeVariant="Default">
    <!-- System theme variant (Dark/Light based on system preference) -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Initial theme for design time and startup -->
                <ResourceInclude Source="avares://WorkLedger-Client/Assets/themes/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
